def _project_show(args, api_key, team_id):
    """Detail view for one project. Accepts a UUID (queried directly) or a name
    with exact match preferred over substring, so 'Rush' stays addressable once
    'Rush App' / 'Rush CLI' also exist (RUSH-1497)."""
    value = args.name
    if len(value) == 36 and value.count("-") == 4:
        proj_id = value
    else:
        projects = list_team_projects(api_key, team_id)
        matches = [p for p in projects if p["name"].lower() == value.lower()]
        if not matches:
            matches = [p for p in projects if value.lower() in p["name"].lower()]
        if not matches:
            print(f"No project matching '{value}'.{_suggest(value, [p['name'] for p in projects])}")
            return
        if len(matches) > 1:
            print(f"Note: '{value}' matched {len(matches)} projects; "
                  f"showing '{matches[0]['name']}'. Use the exact name or id to disambiguate.",
                  file=sys.stderr)
        proj_id = matches[0]["id"]

    data = gql(api_key, """
        query($id: String!) {
            project(id: $id) {
                id name state progress scope priority
                description
                startDate targetDate
                lead { name email }
                projectMilestones(first: 50) {
                    nodes { id name description targetDate sortOrder }
                }
            }
        }
    """, {"id": proj_id})
    if check_errors(data):
        return
    proj = (data.get("data") or {}).get("project") or {}
    if not proj:
        print(f"No project with id '{proj_id}'.")
        return
    if args.json:
        print(json.dumps(proj, indent=2))
        return
    lead = (proj.get("lead") or {}).get("name") or "-"
    count = int(proj.get("scope") or 0)
    print(f"{proj['name']}")
    print(f"  State:    {proj.get('state', '-')}")
    print(f"  Priority: {PRIORITY_MAP.get(proj.get('priority') or 0, '-')}")
    print(f"  Progress: {int((proj.get('progress') or 0) * 100)}%")
    print(f"  Issues:   {count}")
    print(f"  Lead:     {lead}")
    print(f"  Start:    {proj.get('startDate') or '-'}")
    print(f"  Target:   {proj.get('targetDate') or '-'}")
    print(f"  ID:       {proj.get('id')}")
    desc = (proj.get("description") or "").strip()
    if desc:
        print(f"  Description:")
        for line in desc.splitlines() or [desc]:
            print(f"    {line}")
    milestones = (proj.get("projectMilestones") or {}).get("nodes", [])
    roll = milestone_rollup(api_key, proj_id)
    if milestones:
        milestones.sort(key=lambda m: m.get("sortOrder") or 0)
        print(f"\nMilestones ({len(milestones)}):")
        for m in milestones:
            tgt = m.get("targetDate") or "-"
            print(f"  - {m['name']:30s}  target: {tgt:12s}  {_fmt_rollup(roll.get(m['id']))}")
    none_entry = roll.get("_none")
    if none_entry and none_entry.get("total"):
        print(f"  - {'— No milestone':30s}  target: {'-':12s}  {_fmt_rollup(none_entry)}")


def _project_create(args, api_key, team_id):
    """Create a project on the current team. Lead is resolved by email; start /
    target are TimelessDates (YYYY-MM-DD)."""
    input_obj = {"teamIds": [team_id], "name": args.name}
    if args.description is not None:
        input_obj["description"] = args.description
    if args.lead is not None:
        lead_id = resolve_user_id_by_email(api_key, args.lead.strip())
        if not lead_id:
            print(f"Lead '{args.lead}' not found (pass an email).", file=sys.stderr)
            sys.exit(1)
        input_obj["leadId"] = lead_id
    start = parse_timeless_date(args.start, "--start")
    if start:
        input_obj["startDate"] = start
    target = parse_timeless_date(args.target, "--target")
    if target:
        input_obj["targetDate"] = target
    data = gql(api_key, """
        mutation($input: ProjectCreateInput!) {
            projectCreate(input: $input) {
                success
                project { id name url }
            }
        }
    """, {"input": input_obj})
    if check_errors(data):
        sys.exit(1)
    result = (data.get("data") or {}).get("projectCreate") or {}
    if not result.get("success"):
        print("Project create failed.", file=sys.stderr)
