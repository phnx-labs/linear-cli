def cmd_projects(args, cfg, api_key, team_id):
    """List projects, or show one project's detail with its milestones."""
    projects = list_team_projects(api_key, team_id)
    if not projects:
        print("No projects found.")
        return

    if args.name:
        matches = [p for p in projects if args.name.lower() in p["name"].lower()]
        if not matches:
            print(f"No project matching '{args.name}'.")
            return
        p = matches[0]
        data = gql(api_key, """
            query($id: String!) {
                project(id: $id) {
                    name state progress
                    description
                    startDate targetDate
                    lead { name email }
                    projectMilestones(first: 50) {
                        nodes { name description targetDate sortOrder }
                    }
                }
            }
        """, {"id": p["id"]})
        if check_errors(data):
            return
        proj = (data.get("data") or {}).get("project") or {}
        if args.json:
            print(json.dumps(proj, indent=2))
            return
        lead = (proj.get("lead") or {}).get("name") or "-"
        print(f"{proj['name']}")
        print(f"  State:    {proj.get('state', '-')}")
        print(f"  Progress: {int((proj.get('progress') or 0) * 100)}%")
        print(f"  Lead:     {lead}")
        print(f"  Target:   {proj.get('targetDate') or '-'}")
        milestones = (proj.get("projectMilestones") or {}).get("nodes", [])
        if milestones:
            milestones.sort(key=lambda m: m.get("sortOrder") or 0)
            print(f"\nMilestones ({len(milestones)}):")
            for m in milestones:
                tgt = m.get("targetDate") or "-"
                print(f"  - {m['name']:30s}  target: {tgt}")
        return

    if args.json:
        print(json.dumps(projects, indent=2))
        return

    print(f"{len(projects)} project(s):")
    for p in projects:
        progress = int((p.get("progress") or 0) * 100)
        state = p.get("state") or "-"
        lead = (p.get("lead") or {}).get("name") or "-"
        print(f"  {p['name']:40s}  {state:12s}  {progress:>3}%  lead: {lead}")


def cmd_labels(args, cfg, api_key, team_id):
    """List labels available to the team."""
    data = gql(api_key, """
        query($teamId: ID!) {
            issueLabels(
                filter: {
                    or: [
                        { team: { id: { eq: $teamId } } }
                        { team: { null: true } }
                    ]
                }
                first: 200
            ) {
                nodes { id name description color }
            }
        }
    """, {"teamId": team_id})
    if check_errors(data):
        return
    labels = data["data"]["issueLabels"]["nodes"]
    labels.sort(key=lambda l: l["name"].lower())
    if args.json:
        print(json.dumps(labels, indent=2))
        return
    print(f"{len(labels)} label(s):")
    for l in labels:
        desc = l.get("description") or ""
        print(f"  {l['name']:30s}  {desc}")


def cmd_users(args, cfg, api_key, team_id):
    """List assignable users."""
    data = gql(api_key, """
        {
            users(filter: { active: { eq: true } }, first: 200) {
                nodes { id name email displayName }
            }
        }
    """)
    if check_errors(data):
        return
    users = data["data"]["users"]["nodes"]
    users.sort(key=lambda u: u["name"].lower())
    if args.json:
        print(json.dumps(users, indent=2))
        return
    print(f"{len(users)} user(s):")
    for u in users:
        print(f"  {u['name']:25s}  {u.get('email') or '-'}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="linear",
        description="Task management CLI for AI agent teams",
    )
    parser.add_argument("--version", action="version", version=f"linear-cli {__version__}")
    parser.add_argument("--team", default=None,
                        help="Override team for this invocation (key like 'ANT' or UUID)")
    sub = parser.add_subparsers(dest="command")

    # setup
    p_setup = sub.add_parser("setup", help="Configure Linear connection and agent identity")
    p_setup.add_argument("--api-key", help="Linear API key")
    p_setup.add_argument("--agent", help="Default agent identity")

    # tasks (list + view + board)
    p_tasks = sub.add_parser("tasks", help="List tasks, view details, or show team board")
    p_tasks.add_argument("identifier", nargs="?", help="Issue identifier for detail view (e.g. ANT-42)")
    p_tasks.add_argument("--agent", help="Filter by agent label (e.g. --agent claude)")
    p_tasks.add_argument("--all", action="store_true", help="Ignore default agent filter, show all")
    p_tasks.add_argument("--board", action="store_true", help="Team board grouped by agent")
    p_tasks.add_argument("--label", help="Filter by any label")
    p_tasks.add_argument("--status", help="Filter: backlog, todo, progress, done, open")
    p_tasks.add_argument("--cycle", default="active", choices=["active", "next"])
    p_tasks.add_argument("--query", help="Search title + description (case-insensitive)")
    p_tasks.add_argument("--json", action="store_true", help="JSON output")

    # update (all mutations on an issue)
    p_update = sub.add_parser("update", help="Update an issue (status, comment)")
    p_update.add_argument("identifier", help="Issue identifier (e.g. ANT-42)")
    status_group = p_update.add_mutually_exclusive_group()
    status_group.add_argument("--done", action="store_true", help="Mark Done")
    status_group.add_argument("--pickup", action="store_true", help="Mark In Progress")
    status_group.add_argument("--todo", action="store_true", help="Mark Todo")
    status_group.add_argument("--status", help="Move to any state by name")
    p_update.add_argument("--comment", help="Add a comment")
    p_update.add_argument("--proof", action="append",
                          help="Proof of completion (repeatable). File path, URL, or text.")
    p_update.add_argument("--label", action="append", help="Add label(s) (repeatable)")
    p_update.add_argument("--unlabel", action="append",
                          help="Remove label(s) (repeatable)")
    p_update.add_argument("--priority", type=str, default=None,
                          help="urgent, high, medium, low, or none")
    p_update.add_argument("--assign", default=None,
                          help="Reassign: email address, or 'none' to unassign")
    p_update.add_argument("--estimate", type=int, default=None,
                          help="Story-point estimate (integer)")
    p_update.add_argument("--parent", default=None,
                          help="Set parent issue (e.g. ANT-42), or 'none' to detach")
    p_update.add_argument("--project", default=None,
                          help="Move to project (name or ID), or 'none' to detach")
    p_update.add_argument("--milestone", default=None,
                          help="Set milestone (name), or 'none' to detach")
    p_update.add_argument("--title", default=None, help="Rename the issue")
    p_update.add_argument("--description", default=None,
                          help="Replace the issue description")
    p_update.add_argument("--description-file", dest="description_file", default=None,
                          help="Read description from a file path, or '-' for stdin")
    p_update.add_argument("--due-date", dest="due_date",
                          help="Set due date (YYYY-MM-DD), or 'none' to clear")
    p_update.add_argument("--cycle", choices=["active", "next", "none"],
                          help="Move issue: active cycle, next cycle, or remove from cycle")

    # create
    p_create = sub.add_parser("create", help="Create a new issue")
    p_create.add_argument("title", nargs="?", default=None,
                          help="Issue title (optional if --description provided)")
    p_create.add_argument("--label", action="append", help="Label(s) to add (repeatable)")
    p_create.add_argument("--priority", type=str, default=None,
                          help="urgent, high, medium (default), low, or none")
    p_create.add_argument("--description", help="Issue description")
    p_create.add_argument("--description-file", dest="description_file", default=None,
                          help="Read description from a file path, or '-' for stdin")
    p_create.add_argument("--status", help="Initial status (default: Todo)")
    p_create.add_argument("--cycle", default="active",
                          choices=["active", "next", "none"],
                          help="Cycle assignment (default: active)")
    p_create.add_argument("--due-date", dest="due_date",
                          help="Due date (YYYY-MM-DD)")
    p_create.add_argument("--assign", default=None,
                          help="Assignee: email address, or 'none' (default: API key owner)")
    p_create.add_argument("--estimate", type=int, default=None,
                          help="Story-point estimate (integer)")
    p_create.add_argument("--from-file", dest="from_file", default=None,
                          help="Bulk create from JSONL (one issue per line). '-' for stdin.")
    p_create.add_argument("--parent", default=None,
                          help="Parent issue identifier for sub-issues (e.g. ANT-42)")
    p_create.add_argument("--project", default=None,
                          help="Project name or ID")
    p_create.add_argument("--milestone", default=None,
                          help="Project milestone name (resolved within --project if set)")

    # cycles (list all cycles for the team)
    p_cycles = sub.add_parser("cycles", help="List all cycles for the team")
    p_cycles.add_argument("--json", action="store_true", help="JSON output")

    # projects (list / detail with milestones)
    p_projects = sub.add_parser("projects", help="List projects or show detail + milestones")
    p_projects.add_argument("name", nargs="?",
                            help="Project name (substring match) for detail view")
    p_projects.add_argument("--json", action="store_true", help="JSON output")

    # labels
    p_labels = sub.add_parser("labels", help="List available labels")
    p_labels.add_argument("--json", action="store_true", help="JSON output")

    # users
    p_users = sub.add_parser("users", help="List assignable users")
    p_users.add_argument("--json", action="store_true", help="JSON output")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    cfg = load_config()

    if args.command == "setup":
        cmd_setup(args, cfg)
        return

    # All other commands need credentials
    api_key = get_api_key(cfg)
    team_id = get_team_id(cfg)

    if not api_key:
        print("No API key configured. Run: linear setup", file=sys.stderr)
        sys.exit(1)

    if args.team:
        override = resolve_team_id_by_key(api_key, args.team)
        if not override:
            sys.exit(1)
        team_id = override
        # Use a volatile cfg copy — don't pollute on-disk config with the
        # other team's states cache.
        cfg = {**cfg, "states": {}, "__volatile__": True}

    if not team_id:
        print("No team configured. Run: linear setup", file=sys.stderr)
        sys.exit(1)

    if args.command == "tasks":
        cmd_tasks(args, cfg, api_key, team_id)
    elif args.command == "update":
        cmd_update(args, cfg, api_key, team_id)
    elif args.command == "create":
        cmd_create(args, cfg, api_key, team_id)
    elif args.command == "cycles":
        cmd_cycles(args, cfg, api_key, team_id)
    elif args.command == "projects":
        cmd_projects(args, cfg, api_key, team_id)
    elif args.command == "labels":
        cmd_labels(args, cfg, api_key, team_id)
    elif args.command == "users":
        cmd_users(args, cfg, api_key, team_id)


if __name__ == "__main__":
    main()
