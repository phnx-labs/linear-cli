def _build_create_input(api_key: str, team_id: str, cfg: dict, fields: dict,
                        verbose: bool = True) -> tuple[dict | None, str | None]:
    """Build an IssueCreateInput from a flat fields dict (keys match flag names:
    title, description, description_file, priority, parent, project,
    milestone, status, cycle, assign, due_date, label).

    Returns (input_obj, None) on success or (None, error) on hard failure.
    Smart defaults applied silently. Warnings go to stderr when verbose=True.
    """
    def warn(msg):
        if verbose:
            print(f"Warning: {msg}", file=sys.stderr)

    description = read_description(fields.get("description"), fields.get("description_file"))

    title = fields.get("title")
    if not title:
        if not description:
            return None, "no title or description"
        title = derive_title(description)

    for image_path in fields.get("image") or []:
        asset_url = upload_file(api_key, image_path)
        if asset_url:
            description = (description or "") + f"\n\n![{Path(image_path).name}]({asset_url})"

    input_obj: dict = {"teamId": team_id, "title": title}
    if description:
        input_obj["description"] = description

    if fields.get("due_date"):
        try:
            due = parse_due_date(fields["due_date"])
            if due is not None:
                input_obj["dueDate"] = due
        except SystemExit as e:
            return None, str(e)

    try:
        priority = parse_priority(fields["priority"]) if fields.get("priority") is not None else 3
    except SystemExit as e:
        return None, str(e)
    input_obj["priority"] = priority

    if fields.get("parent"):
        parent_issue = resolve_issue(api_key, team_id, fields["parent"])
        if parent_issue:
            input_obj["parentId"] = parent_issue["id"]
            if verbose:
                _warn_sub_issue(title, parent_issue.get("identifier") or fields["parent"])
        else:
            warn(f"parent '{fields['parent']}' not found; creating without parent.")

    # A named --project/--milestone that doesn't resolve is a hard error: creating
    # the issue without it would silently ignore what the user asked for (RUSH-1496).
    project_id = None
    if fields.get("project"):
        try:
            project_id = resolve_project_id(api_key, team_id, fields["project"], strict=True)
        except LookupError as e:
            return None, str(e)
        input_obj["projectId"] = project_id

    if fields.get("milestone"):
        try:
            mid = resolve_milestone_id(api_key, team_id, fields["milestone"], project_id, strict=True)
        except LookupError as e:
            return None, str(e)
        input_obj["projectMilestoneId"] = mid

    desired_status = fields.get("status")
    if not desired_status:
        desired_status = "Backlog" if priority == 4 else "Todo"
    states = get_states(api_key, team_id, cfg)
    sid = resolve_state_id(states, desired_status)
    if sid:
        input_obj["stateId"] = sid
    else:
        warn(f"state '{desired_status}' not found; letting Linear pick the default.")

    cycle_choice = (fields.get("cycle") or "active").lower()
    if cycle_choice in ("active", "next"):
        cid = get_cycle_id(api_key, team_id, cycle_choice)
        if cid:
            input_obj["cycleId"] = cid
        else:
            warn(f"no {cycle_choice} cycle found; creating without cycle.")

    assign_arg = fields.get("assign")
    if assign_arg is None:
        vid = get_viewer_id(api_key, cfg)
        if vid:
            input_obj["assigneeId"] = vid
    elif assign_arg.lower() == "none":
        pass
    else:
        uid = resolve_assignee_id(api_key, assign_arg)
        if uid:
            input_obj["assigneeId"] = uid
        else:
            warn(f"--assign '{assign_arg}' matched no human "
                 f"(try an email, a name, or 'linear users'); leaving unassigned.")

    delegate_arg = fields.get("delegate")
    if delegate_arg and delegate_arg.lower() != "none":
        did = resolve_agent_id(api_key, cfg, delegate_arg)
        if did:
            input_obj["delegateId"] = did
        else:
            names = ", ".join(a["name"] for a in get_agents(api_key, cfg)) or "none installed"
            warn(f"agent '{delegate_arg}' not found; creating without delegate. Available: {names}")

    label_names = fields.get("label") or []
    if isinstance(label_names, str):
        label_names = [label_names]
    if label_names:
        label_map = {l["name"]: l["id"] for l in list_team_labels(api_key, team_id)}
        label_ids = []
        for lbl in label_names:
            if lbl in label_map:
                label_ids.append(label_map[lbl])
            else:
                warn(f"label '{lbl}' not found, skipping.")
        if label_ids:
            input_obj["labelIds"] = label_ids

    return input_obj, None


def _send_issue_create(api_key: str, input_obj: dict) -> tuple[dict | None, str | None]:
    data = gql(api_key, """
        mutation($input: IssueCreateInput!) {
            issueCreate(input: $input) {
                success
                issue { identifier title state { name } cycle { number name } assignee { name } delegate { name } }
            }
        }
    """, {"input": input_obj})
    if data.get("errors"):
        return None, data["errors"][0].get("message", "unknown error")
    result = data["data"]["issueCreate"]
    if not result["success"]:
        return None, "create failed"
    return result["issue"], None


def cmd_create(args, cfg, api_key, team_id):
    if args.from_file:
        return _bulk_create(args.from_file, cfg, api_key, team_id)

    fields = {
        "title": args.title,
        "description": args.description,
        "description_file": args.description_file,
        "priority": args.priority,
        "parent": args.parent,
        "project": args.project,
        "milestone": args.milestone,
        "status": args.status,
        "cycle": args.cycle,
        "assign": args.assign,
        "delegate": args.delegate,
        "due_date": args.due_date,
        "label": args.label or [],
        "image": args.image or [],
    }
    input_obj, err = _build_create_input(api_key, team_id, cfg, fields, verbose=True)
    if err:
        print(err, file=sys.stderr)
        sys.exit(1)
    issue, err = _send_issue_create(api_key, input_obj)
    if err:
        print(f"Error: {err}", file=sys.stderr)
        return
    cyc = cycle_label(issue.get("cycle"))
    asg = (issue.get("assignee") or {}).get("name") or "unassigned"
    dg = (issue.get("delegate") or {}).get("name")
    meta = f"{cyc} | {asg}" + (f" | delegate: {dg}" if dg else "")
    print(f"Created {issue['identifier']}: {issue['title']}  [{meta}]")


def _bulk_create(path: str, cfg, api_key, team_id):
    """Bulk create from JSONL. Each line is a JSON object with field names
    matching the single-create flags. Continue-on-error; tab-separated output:
    OK<TAB>IDENT<TAB>TITLE  or  ERROR<TAB>-<TAB>TITLE<TAB>REASON."""
    if path == "-":
        stream = sys.stdin
    else:
        if not Path(path).exists():
            print(f"--from-file: {path} not found", file=sys.stderr)
            sys.exit(1)
        stream = open(path)

    ok_count = 0
    err_count = 0
    for raw in stream:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            fields = json.loads(line)
        except json.JSONDecodeError as e:
            print(f"ERROR\t-\t<unparseable>\t{e}")
            err_count += 1
            continue

        title_hint = fields.get("title") or (fields.get("description", "")[:60] if fields.get("description") else "<no title>")
        input_obj, err = _build_create_input(api_key, team_id, cfg, fields, verbose=False)
        if err:
            print(f"ERROR\t-\t{title_hint}\t{err}")
            err_count += 1
            continue
        issue, err = _send_issue_create(api_key, input_obj)
        if err:
            print(f"ERROR\t-\t{title_hint}\t{err}")
            err_count += 1
            continue
        print(f"OK\t{issue['identifier']}\t{issue['title']}")
        ok_count += 1

    if path != "-":
        stream.close()
    print(f"\n{ok_count} created, {err_count} failed.", file=sys.stderr)


