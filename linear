def _milestone_list(args, api_key, team_id):
    """List a project's milestones (sorted by sortOrder)."""
    try:
        pid = resolve_project_id(api_key, team_id, args.project, strict=True)
    except LookupError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    data = gql(api_key, """
        query($id: String!) {
            project(id: $id) {
                name
                projectMilestones(first: 100) {
                    nodes { id name description targetDate sortOrder }
                }
            }
        }
    """, {"id": pid})
    if check_errors(data):
        return
    proj = (data.get("data") or {}).get("project") or {}
    nodes = (proj.get("projectMilestones") or {}).get("nodes", [])
    nodes.sort(key=lambda m: m.get("sortOrder") or 0)
    if args.json:
        print(json.dumps(nodes, indent=2))
        return
    if not nodes:
        print(f"No milestones in '{proj.get('name', args.project)}'.")
        return
    # Compute the rollup only for the human view (one extra issue query), so
    # --json neither pays for it nor leaks an undocumented key — same as the
    # sibling `projects show --json` path.
    roll = milestone_rollup(api_key, pid)
    print(f"{len(nodes)} milestone(s) in '{proj.get('name', args.project)}':")
    for m in nodes:
        tgt = m.get("targetDate") or "-"
        print(f"  {m['name']:30s}  target: {tgt:12s}  {_fmt_rollup(roll.get(m['id']))}")
    none_entry = roll.get("_none")
    if none_entry and none_entry.get("total"):
        print(f"  {'— No milestone':30s}  target: {'-':12s}  {_fmt_rollup(none_entry)}")


