def cmd_tasks(args, cfg, api_key, team_id):
    # If an identifier is given, show detail view
    if args.identifier:
        return show_issue_detail(args, api_key, team_id)

    # If --board, show team board
    if args.board:
        return show_board(args, api_key, team_id, cfg)

    # Otherwise, list tasks
    return list_tasks(args, cfg, api_key, team_id)


def list_tasks(args, cfg, api_key, team_id):
    """Default view: issues delegated to my agent + issues with no delegate
    (unowned). Ownership is Linear's native `delegate` field — nothing else.
    `--agent X` narrows to a specific agent. `--all` shows literally every task.
    `--cycle` scopes to the active cycle (default), next cycle, the whole team
    (`all`, cross-cycle + backlog), or the backlog only (`none`).
    `--assignee EMAIL|me|none` filters by who the issue is assigned to.
    `--project NAME|UUID` scopes to one project (strict: unknown name aborts).
    Tasks are sorted by priority, then due date (earliest first), then id.
    Results are fully paginated — no silent truncation at Linear's 50-issue cap.
    """
    filters = [f'team: {{ id: {{ eq: "{team_id}" }} }}']

    # Cycle scope. active/next resolve to a concrete cycle id (and a header
    # name); `all` drops the cycle filter; `none`/`backlog` lists the backlog;
    # any other value is treated as a cycle name or id and resolved.
    scope = resolve_task_scope(args.cycle, getattr(args, "project", None),
                               getattr(args, "milestone", None))
    fragment, scope_label, cycle_meta = build_cycle_scope(api_key, team_id, scope)
    if fragment is None:
        print(f"Could not resolve --cycle '{scope}'.")
        return
    if fragment:
        filters.append(fragment)

    # Optional date floor: only issues created on/after --since (YYYY-MM-DD).
    since = getattr(args, "since", None)
    if since:
        try:
            date.fromisoformat(since)
        except ValueError:
            print(f"Invalid --since '{since}'. Use YYYY-MM-DD.", file=sys.stderr)
            return
        filters.append(f'createdAt: {{ gte: "{since}T00:00:00.000Z" }}')

    # Resolve which agent's queue to show (if any). `--all` overrides config default.
    if args.all:
        requested_agent = None
        include_unowned = False  # --all means show everything including other agents
    elif args.agent:
        requested_agent = args.agent
        include_unowned = False  # explicit agent request — just show their queue
    elif cfg.get("agent"):
        requested_agent = cfg.get("agent")
        include_unowned = True   # default view = my queue + unowned
    else:
        requested_agent = None
        include_unowned = False

    # Ownership is the native `delegate` field. Resolving the requested name
    # against the roster is a *check*, not a requirement: the filter compares
    # delegate names case-insensitively, so the raw name already matches.
    #
    # A typed `--agent` that doesn't resolve is a typo — exit, because silently
    # returning "no matching tasks" reads as an empty queue and unattended drains
    # act on that. The config-derived default is different: `get_agents` degrades
    # to [] on a transient API error (see its `return cached or []`), and bricking
    # the most-used command on a users-query blip is worse than the typo it would
    # catch. Warn and keep going there.
    explicit_agent = None
    if requested_agent:
        explicit_agent = resolve_agent_name(api_key, cfg, requested_agent)
        if not explicit_agent:
            names = ", ".join(a["name"] for a in get_agents(api_key, cfg)) or "none"
            if args.agent:
                print(f"Unknown agent '{requested_agent}'. Delegatable agents: {names}",
                      file=sys.stderr)
                sys.exit(1)
            print(f"Warning: configured agent '{requested_agent}' is not in the agent "
                  f"roster ({names}). Filtering on the name as given — "
                  f"re-run `linear setup --agent <name>` if it was renamed.",
                  file=sys.stderr)
            # `.strip()` to match what resolve_agent_name would have done — a
            # config value of " claude " must still filter.
            explicit_agent = requested_agent.strip()

    # `--label` composes with the agent queue. It used to be suppressed whenever
    # an agent filter was active, because ownership was itself a label and the two
    # label filters fought; ownership is the `delegate` field now, so they are
    # orthogonal and a caller asking for both gets both.
    if args.label:
        filters.append(f'labels: {{ name: {{ eq: "{args.label}" }} }}')

    # Project scope. Strict resolution: a mistyped project must abort, not
    # silently drop the filter and return the whole team queue (unattended
    # consumers act on whatever this lists).
    project = getattr(args, "project", None)
    pid = None
    if project:
        try:
            pid = resolve_project_id(api_key, team_id, project, strict=True)
        except LookupError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        filters.append(f'project: {{ id: {{ eq: "{pid}" }} }}')

    # Milestone scope. Strict like --project: a mistyped milestone aborts rather
    # than silently listing the whole team. Pass --project alongside to
    # disambiguate a milestone name that exists in more than one project.
    milestone = getattr(args, "milestone", None)
    if milestone:
        try:
            mid = resolve_milestone_id(api_key, team_id, milestone, pid, strict=True)
        except LookupError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        if not mid:
            print(f"No milestone matching '{milestone}'.", file=sys.stderr)
            sys.exit(1)
        filters.append(f'projectMilestone: {{ id: {{ eq: "{mid}" }} }}')

    # Assignee filter: 'me' = API-key owner, 'none' = unassigned, else email.
    assignee = getattr(args, "assignee", None)
    if assignee:
        if assignee.lower() == "none":
            filters.append("assignee: { null: true }")
        else:
            if assignee.lower() == "me":
                uid = get_viewer_id(api_key, cfg)
            else:
                uid = resolve_user_id_by_email(api_key, assignee)
            if not uid:
                print(f"Could not resolve assignee '{assignee}'.", file=sys.stderr)
                return
            filters.append(f'assignee: {{ id: {{ eq: "{uid}" }} }}')

    if getattr(args, "query", None):
        q = args.query.replace('"', '\\"')
        filters.append(
            f'or: [ {{ title: {{ containsIgnoreCase: "{q}" }} }}, '
            f'{{ description: {{ containsIgnoreCase: "{q}" }} }} ]'
        )

    if args.status:
        status = args.status.lower()
        if status == "open":
            filters.append('state: { type: { nin: ["completed", "canceled"] } }')
        elif status == "done":
            filters.append('state: { type: { eq: "completed" } }')
        else:
            states = get_states(api_key, team_id, cfg)
            sid = resolve_state_id(states, status)
            if sid:
                filters.append(f'state: {{ id: {{ eq: "{sid}" }} }}')
            else:
                filters.append(f'state: {{ name: {{ eqi: "{status}" }} }}')
    else:
        filters.append('state: { type: { nin: ["completed", "canceled"] } }')

    filter_str = ", ".join(filters)

    nodes = paginate_issues(api_key, filter_str)
    if nodes is None:
        return

    # Apply the delegate filter client-side so "my tasks + unowned" is expressible
    # in one pass (Linear can't express `delegate = X OR delegate IS NULL` in a
    # single server-side filter, and the page is already fetched).
    if explicit_agent:
        def match(n):
            if delegated_to(n, explicit_agent):
                return True
            return include_unowned and delegate_of(n) is None

        nodes = [n for n in nodes if match(n)]

    nodes.sort(key=issue_sort_key)

    if args.json:
        print(json.dumps({
            "scope": scope,
            "cycle": cycle_meta,
            "count": len(nodes),
            "issues": nodes,
        }, indent=2))
        return

    if not nodes:
        print(f"No matching tasks in {scope_label}.")
        return

    header_note = ""
    if explicit_agent and include_unowned:
        owned = sum(1 for n in nodes if delegated_to(n, explicit_agent))
        unowned = len(nodes) - owned
        header_note = f"  ({owned} yours, {unowned} unowned)"
    print(f"{scope_label} -- {len(nodes)} task(s){header_note}")
    print()
    # Group by milestone when asked (--by-milestone) or when scoped to a project
    # (the natural project view). The milestone name is already on each issue via
    # ISSUE_FIELDS, so this is a local group-by with no extra API calls.
    if getattr(args, "by_milestone", False) or bool(project):
        print_by_milestone(nodes)
    else:
        for n in nodes:
            print(format_issue_row(n))


def show_board(args, api_key, team_id, cfg):
    # Same cycle scoping as list_tasks (active/next/all/none/name/id), so the
    # board no longer hits the non-existent team.nextCycle field, and it
    # paginates instead of silently capping at 50 open issues.
    # --cycle defaults to None at the parser (so list_tasks can widen it); the
    # board has no project/milestone scope to widen for, so None means active —
    # normalize here so the --json "scope" field stays "active", not null.
    scope = args.cycle or "active"
    fragment, scope_label, cycle_meta = build_cycle_scope(api_key, team_id, scope)
    if fragment is None:
        print(f"Could not resolve --cycle '{scope}'.")
        return

    filters = [
        f'team: {{ id: {{ eq: "{team_id}" }} }}',
        'state: { type: { nin: ["completed", "canceled"] } }',
    ]
    if fragment:
        filters.append(fragment)

    nodes = paginate_issues(api_key, ", ".join(filters))
    if nodes is None:
        return

    cycle_name = scope_label

    if args.json:
        print(json.dumps({
            "scope": scope,
            "cycle": cycle_meta,
            "count": len(nodes),
            "issues": nodes,
        }, indent=2))
        return

    if not nodes:
        print(f"No open tasks in {cycle_name}.")
        return

    # Group by the native delegate. An issue has at most one delegate, so a board
    # column is exactly one agent's queue; no delegate means unassigned.
    agents: dict[str, list] = {}
    unassigned: list = []

    for n in nodes:
        dn = delegate_of(n)
        if dn:
            agents.setdefault(dn, []).append(n)
        else:
            unassigned.append(n)

    print(f"{cycle_name} -- {len(nodes)} task(s)")
    print()

    for agent_name in sorted(agents.keys()):
        issues = agents[agent_name]
        issues.sort(key=issue_sort_key)
        print(f"  @{agent_name} ({len(issues)})")
        for n in issues:
            pri = PRIORITY_MAP.get(n.get("priority", 0), "-")
            state = n["state"]["name"]
            due = format_due(n.get("dueDate"))
            print(f"    {n['identifier']:<8} {pri:<7}  {state:<12}  {due}  {n['title']}")
        print()

    if unassigned:
        unassigned.sort(key=issue_sort_key)
        print(f"  unassigned ({len(unassigned)})")
        for n in unassigned:
            pri = PRIORITY_MAP.get(n.get("priority", 0), "-")
            state = n["state"]["name"]
            due = format_due(n.get("dueDate"))
            labels = [l["name"] for l in n.get("labels", {}).get("nodes", [])]
            label_str = f"  [{', '.join(labels)}]" if labels else ""
            print(f"    {n['identifier']:<8} {pri:<7}  {state:<12}  {due}  {n['title']}{label_str}")
        print()


def show_issue_detail(args, api_key, team_id):
    identifier = args.identifier
    number = identifier.split("-")[-1]
    try:
        number = int(number)
    except ValueError:
        print(f"Invalid identifier: {identifier}", file=sys.stderr)
        sys.exit(1)

    data = gql(api_key, f"""{{
        issues(filter: {{
            team: {{ id: {{ eq: "{team_id}" }} }}
            number: {{ eq: {number} }}
        }}) {{
            nodes {{
                id identifier title description url
                state {{ name }}
                priority dueDate
                labels {{ nodes {{ name }} }}
                assignee {{ name }}
                delegate {{ name }}
                project {{ name }}
                projectMilestone {{ name }}
                cycle {{ number name }}
                parent {{ identifier title }}
                createdAt updatedAt
                relations {{ nodes {{ type relatedIssue {{ identifier title }} }} }}
                inverseRelations {{ nodes {{ type issue {{ identifier title }} }} }}
                comments {{ nodes {{ body createdAt user {{ name }} }} }}
            }}
        }}
    }}""")

    if check_errors(data):
        return

    nodes = data.get("data", {}).get("issues", {}).get("nodes", [])
    if not nodes:
        print(f"Issue {identifier} not found.")
        return

    n = nodes[0]

    if args.json:
        print(json.dumps(n, indent=2))
        return

    pri = PRIORITY_MAP.get(n.get("priority", 0), "-")
    labels = ", ".join(l["name"] for l in n.get("labels", {}).get("nodes", []))
    assignee = n.get("assignee")
    assignee_name = assignee.get("name", "Unassigned") if assignee else "Unassigned"
    delegate = n.get("delegate")
    delegate_name = delegate.get("name") if delegate else None

    print(f"{n['identifier']}  {n['title']}")
    print(f"  Status:   {n['state']['name']}")
    print(f"  Priority: {pri}")
    print(f"  Labels:   {labels or '-'}")
    print(f"  Assignee: {assignee_name}")
    if delegate_name:
        print(f"  Delegate: {delegate_name}")
    if n.get("dueDate"):
        print(f"  Due:      {n['dueDate']}")
    if n.get("project"):
        print(f"  Project:  {n['project']['name']}")
    if n.get("projectMilestone"):
        print(f"  Milestone: {n['projectMilestone']['name']}")
    if n.get("cycle"):
        print(f"  Cycle:    {cycle_label(n['cycle'])}")
    if n.get("parent"):
        print(f"  Parent:   {n['parent']['identifier']}  {n['parent']['title']}")
    if n.get("url"):
        print(f"  URL:      {n['url']}")

    # Relations: forward edges (this blocks / relates to X) + inverse (X blocks this).
    rel_lines = []
    for r in (n.get("relations") or {}).get("nodes", []):
        other = r.get("relatedIssue") or {}
        verb = {"blocks": "Blocks", "related": "Related to", "duplicate": "Duplicate of"}.get(r.get("type"), r.get("type"))
        rel_lines.append(f"  {verb}: {other.get('identifier', '?')}  {other.get('title', '')}")
    for r in (n.get("inverseRelations") or {}).get("nodes", []):
        other = r.get("issue") or {}
        # "related"/"duplicate" are symmetric, so they must render from the
        # inverse side too; "blocks" inverts to "blocked by".
        verb = {"blocks": "Blocked by", "related": "Related to", "duplicate": "Duplicate of"}.get(r.get("type"), r.get("type"))
        rel_lines.append(f"  {verb}: {other.get('identifier', '?')}  {other.get('title', '')}")
    if rel_lines:
        print("  Relations:")
        for line in rel_lines:
            print(f"  {line}")
    print()

    desc = n.get("description", "")
    if desc:
        print("Description:")
        for line in desc.split("\n"):
            print(f"  {line}")
        print()

    comments = n.get("comments", {}).get("nodes", [])
    if comments:
        print(f"Comments ({len(comments)}):")
        for c in comments:
            user = c.get("user", {}).get("name", "Unknown")
            body = c.get("body", "").strip().replace("\n", "\n    ")
            print(f"  [{user}] {body}")
        print()


