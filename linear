def collect_update_identifiers(identifiers, stdin_lines=None) -> list[str]:
    collected = list(identifiers or [])
    for line in stdin_lines or []:
        collected.extend(line.split())
    return list(dict.fromkeys(collected))


def run_bulk_update(args, cfg, api_key, team_id, identifiers: list[str],
                    project_id=_UNSET, milestone_id=_UNSET,
                    resolve_issue_fn=None, apply_update_fn=None):
    resolve_issue_fn = resolve_issue_fn or resolve_issue
    apply_update_fn = apply_update_fn or _apply_update
    total = len(identifiers)
    succeeded = 0
    failed: list[str] = []
    for i, ident in enumerate(identifiers, 1):
        issue = resolve_issue_fn(api_key, team_id, ident)
        if not issue:
            print(f"[{i}/{total}] {ident} -> not found")
            failed.append(ident)
            continue
        print(f"[{i}/{total}] {issue['identifier']}")
        try:
            if apply_update_fn(args, cfg, api_key, team_id, issue, single=False,
                               project_id=project_id, milestone_id=milestone_id):
                succeeded += 1
            else:
                failed.append(ident)
        except Exception as e:  # never let one ticket abort the batch
            print(f"  error: {e}", file=sys.stderr)
            failed.append(ident)

    summary = f"\n{succeeded}/{total} updated."
    if failed:
        summary += f" Failed: {', '.join(failed)}"
    sys.stdout.flush()  # keep per-issue progress ahead of the summary when piped
    print(summary, file=sys.stderr)
    if failed:
        sys.exit(1)


def cmd_update(args, cfg, api_key, team_id):
    """Dispatcher: apply the same set of changes to one or many issues.

    Identifiers come from positional args and/or --stdin (whitespace-separated,
    xargs-friendly). A single identifier keeps the original detailed output; two
    or more switch to compact per-issue progress with an error roll-up at the
    end so one bad ticket never aborts the batch.
    """
    # Require proof when marking done — checked once up front for the whole batch.
    if args.done and not args.proof:
        print("Cannot mark done without proof. Provide at least one --proof:", file=sys.stderr)
        print("  --proof /path/to/screenshot.png   (file upload)", file=sys.stderr)
        print("  --proof https://example.com/result (URL)", file=sys.stderr)
        print('  --proof "Sent 15/30 emails"        (text)', file=sys.stderr)
        sys.exit(1)

    stdin_lines = sys.stdin if getattr(args, "stdin", False) else None
    identifiers = collect_update_identifiers(args.identifier, stdin_lines)
    if not identifiers:
        print("No issue identifier given.", file=sys.stderr)
        sys.exit(1)

    # Next-invocation drain: a previous --done that hit a rate limit may have
    # left intents on disk. Clear them before adding a new close so the board
    # stays honest across invocations.
    if args.done:
        drain_queue(api_key, team_id, cfg, quiet=True)

    # Resolve --project / --milestone ONCE, up front and strictly. An unknown
    # name aborts the whole run with a non-zero exit instead of silently no-op'ing
    # every issue in a batch while reporting success (RUSH-1496); resolving once
    # also avoids a per-issue project lookup on bulk updates.
    project_id = _UNSET
    milestone_id = _UNSET
    try:
        # Truthy (not `is not None`) so an empty `--project ""` is a no-op, not a
        # clear — only an explicit `--project none` clears the field.
        if args.project:
            project_id = (None if args.project.lower() == "none"
                          else resolve_project_id(api_key, team_id, args.project, strict=True))
        if args.milestone:
            scope = project_id if project_id not in (_UNSET, None) else None
            milestone_id = (None if args.milestone.lower() == "none"
                            else resolve_milestone_id(api_key, team_id, args.milestone, scope, strict=True))
    except LookupError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    if len(identifiers) == 1:
        issue = resolve_issue(api_key, team_id, identifiers[0])
        if not issue:
            print(f"Issue {identifiers[0]} not found.")
            sys.exit(1)
        ok = _apply_update(args, cfg, api_key, team_id, issue, single=True,
                           project_id=project_id, milestone_id=milestone_id)
        if not ok:
            sys.exit(1)
        return

    run_bulk_update(args, cfg, api_key, team_id, identifiers,
                    project_id=project_id, milestone_id=milestone_id)


def _apply_update(args, cfg, api_key, team_id, issue, single=True,
                  project_id=_UNSET, milestone_id=_UNSET) -> bool:
    """Apply every requested change to one resolved issue. Returns True if at
    least one change was made. Never mutates `args` (so it is safe to call in a
    loop) and never calls sys.exit (so a failure on one issue can be rolled up
    by the bulk caller). Hard per-issue failures return False.

    project_id / milestone_id are pre-resolved once by cmd_update: _UNSET means
    the flag was absent (leave the field alone), None means clear it, a string
    means set it."""
    identifier = issue.get("identifier") or args.identifier
    did_something = False

    # A local copy so the bulk loop doesn't see comment cleared after issue #1.
    comment = args.comment

    # Post proof as a comment before status change. When closing (--done),
    # proof is handled durably by the close queue so a rate limit cannot drop
    # it between the comment and the status change.
    if args.proof and not args.done:
        proof_body = build_proof_comment(api_key, args.proof)
        if comment:
            proof_body = f"{comment}\n\n{proof_body}"

        data = gql(api_key, """
            mutation($input: CommentCreateInput!) {
                commentCreate(input: $input) { success }
            }
        """, {"input": {"issueId": issue["id"], "body": proof_body}})

        if check_errors(data):
            return False
        if data["data"]["commentCreate"]["success"]:
            print(f"Proof posted to {identifier}.")
        else:
            print("Proof comment failed.", file=sys.stderr)
            return False
        did_something = True
        # Comment already included in proof, don't post separately
        comment = None

    # Status change
    target_state = None
    if args.done:
        target_state = "Done"
    elif args.pickup:
        target_state = "In Progress"
    elif args.todo:
        target_state = "Todo"
    elif args.status:
        target_state = args.status

    if target_state:
        if args.done:
            # Close is the one operation that must survive rate limits. Persist
            # the intent before trying, attempt immediately, and keep it on
            # transient failure for the next drain.
            ok = queue_close_and_try(
                api_key, team_id, cfg, issue, target_state,
                proof=args.proof,
                comment=comment,
                quiet=False,
            )
            if not ok:
                return False
            did_something = True
        else:
            states = get_states(api_key, team_id, cfg)
            state_id = resolve_state_id(states, target_state)
            if not state_id:
                print(f"State '{target_state}' not found. Available: {', '.join(states.keys())}", file=sys.stderr)
                return False

            data = gql(api_key, """
                mutation($id: String!, $stateId: String!) {
                    issueUpdate(id: $id, input: { stateId: $stateId }) {
                        success
                        issue { identifier title state { name } }
                    }
                }
            """, {"id": issue["id"], "stateId": state_id})

            if check_errors(data):
                return False

            result = data["data"]["issueUpdate"]
            if result["success"]:
                i = result["issue"]
                print(f"{i['identifier']} -> {i['state']['name']}")
            else:
                print("Status update failed.")
            did_something = True

    # Issue relations. Linear models all of these as one relation with a
    # direction: "A blocks B" is the same edge as "B blocked-by A", so
    # --blocked-by just flips which side is the issueId. type is blocks|related.
    rel_specs = []
    for ident in (args.blocks or []):
        rel_specs.append(("blocks", ident, "forward", "blocks"))
    for ident in (args.blocked_by or []):
        rel_specs.append(("blocked by", ident, "inverse", "blocks"))
    for ident in (args.relates or []):
        rel_specs.append(("related to", ident, "forward", "related"))
    for verb, ident, direction, rel_type in rel_specs:
        other = resolve_issue(api_key, team_id, ident)
        if not other:
            print(f"Related issue {ident} not found, skipping.", file=sys.stderr)
            continue
        if direction == "forward":
            issue_id, related_id = issue["id"], other["id"]
        else:
            issue_id, related_id = other["id"], issue["id"]
        rel_data = gql(api_key, """
            mutation($input: IssueRelationCreateInput!) {
                issueRelationCreate(input: $input) { success }
            }
        """, {"input": {"issueId": issue_id, "relatedIssueId": related_id, "type": rel_type}})
        if check_errors(rel_data):
            continue
        if (rel_data.get("data") or {}).get("issueRelationCreate", {}).get("success"):
            print(f"{identifier} {verb} {other['identifier']}")
            did_something = True
        else:
            print(f"Failed to link {identifier} {verb} {ident}.", file=sys.stderr)

    # Labels (add via --label, remove via --unlabel)
    if args.label or args.unlabel:
        all_labels = list_team_labels(api_key, team_id)
        if all_labels is not None:
            label_map = {l["name"]: l["id"] for l in all_labels}

            # Also get current labels on the issue
            issue_data = gql(api_key, f"""{{
                issue(id: "{issue['id']}") {{
                    labels {{ nodes {{ id name }} }}
                }}
            }}""")
            current_ids = []
            current_names_by_id = {}
            if not check_errors(issue_data):
                for l in issue_data["data"]["issue"]["labels"]["nodes"]:
                    current_ids.append(l["id"])
                    current_names_by_id[l["id"]] = l["name"]

            label_ids = list(current_ids)
            added = []
            for lbl in args.label or []:
                if lbl in label_map:
                    if label_map[lbl] not in label_ids:
                        label_ids.append(label_map[lbl])
                        added.append(lbl)
                else:
                    print(f"Warning: label '{lbl}' not found, skipping.", file=sys.stderr)

            removed = []
            for lbl in args.unlabel or []:
                if lbl in label_map and label_map[lbl] in label_ids:
                    label_ids.remove(label_map[lbl])
                    removed.append(lbl)
                else:
                    print(f"Warning: label '{lbl}' not on this issue, skipping.", file=sys.stderr)

            if added or removed:
                data = gql(api_key, """
                    mutation($id: String!, $labelIds: [String!]!) {
                        issueUpdate(id: $id, input: { labelIds: $labelIds }) {
                            success
                        }
                    }
                """, {"id": issue["id"], "labelIds": label_ids})

                if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                    parts = []
                    if added:
                        parts.append(f"added {', '.join(added)}")
                    if removed:
                        parts.append(f"removed {', '.join(removed)}")
                    print(f"Labels on {identifier}: {'; '.join(parts)}")
                else:
                    print("Label update failed.")
                did_something = True

    # Cycle move: --cycle active | next | none
    if args.cycle:
        choice = args.cycle.lower()
        new_cycle_id: str | None = None
        if choice == "none":
            new_cycle_id = None
        elif choice in ("active", "next"):
            new_cycle_id = get_cycle_id(api_key, team_id, choice)
            if not new_cycle_id:
                print(f"Warning: no {choice} cycle found; skipping cycle move.", file=sys.stderr)
                new_cycle_id = ...  # sentinel — skip mutation below

        if new_cycle_id is not ...:
            data = gql(api_key, """
                mutation($id: String!, $cycleId: String) {
                    issueUpdate(id: $id, input: { cycleId: $cycleId }) {
                        success
                        issue { identifier cycle { number name } }
                    }
                }
            """, {"id": issue["id"], "cycleId": new_cycle_id})
            if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                i = data["data"]["issueUpdate"]["issue"]
                cyc = cycle_label(i.get("cycle"))
                print(f"{i['identifier']} -> cycle: {cyc}")
                did_something = True
            else:
                print("Cycle update failed.")

    # Title / description: batched in one mutation
    title_desc_input: dict = {}
    if args.title is not None:
        title_desc_input["title"] = args.title
    description = read_description(args.description, args.description_file)
    if description is not None:
        title_desc_input["description"] = description
    if args.parent is not None:
        if args.parent.lower() == "none":
            title_desc_input["parentId"] = None
        else:
            parent_issue = resolve_issue(api_key, team_id, args.parent)
            if parent_issue:
                title_desc_input["parentId"] = parent_issue["id"]
                _warn_sub_issue(identifier, parent_issue.get("identifier") or args.parent)
            else:
                print(f"Warning: parent '{args.parent}' not found; skipping.", file=sys.stderr)
    # project_id / milestone_id are pre-resolved (strictly) by cmd_update.
    if project_id is not _UNSET:
        title_desc_input["projectId"] = project_id
    if milestone_id is not _UNSET:
        title_desc_input["projectMilestoneId"] = milestone_id
    if title_desc_input:
        data = gql(api_key, """
            mutation($id: String!, $input: IssueUpdateInput!) {
                issueUpdate(id: $id, input: $input) {
                    success
                    issue { identifier title }
                }
            }
        """, {"id": issue["id"], "input": title_desc_input})
        if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
            i = data["data"]["issueUpdate"]["issue"]
            changed = ", ".join(title_desc_input.keys())
            print(f"{i['identifier']} -> updated: {changed}")
            did_something = True
        else:
            print("Title/description update failed.")

    # Priority: --priority urgent|high|medium|low|none
    if args.priority is not None:
        pri = parse_priority(args.priority)
        data = gql(api_key, """
            mutation($id: String!, $priority: Int!) {
                issueUpdate(id: $id, input: { priority: $priority }) {
                    success
                    issue { identifier priority }
                }
            }
        """, {"id": issue["id"], "priority": pri})
        if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
            i = data["data"]["issueUpdate"]["issue"]
            name = PRIORITY_MAP.get(i.get("priority", 0), "-")
            print(f"{i['identifier']} -> priority: {name}")
            did_something = True
        else:
            print("Priority update failed.")

    # Assign: --assign email | none
    if args.assign is not None:
        if args.assign.lower() == "none":
            assignee_id = None
        else:
            assignee_id = resolve_assignee_id(api_key, args.assign)
            if not assignee_id:
                print(f"Warning: --assign '{args.assign}' matched no human "
                      f"(try an email, a name, or 'linear users'); skipping reassign.", file=sys.stderr)
                assignee_id = ...

        if assignee_id is not ...:
            data = gql(api_key, """
                mutation($id: String!, $assigneeId: String) {
                    issueUpdate(id: $id, input: { assigneeId: $assigneeId }) {
                        success
                        issue { identifier assignee { name } }
                    }
                }
            """, {"id": issue["id"], "assigneeId": assignee_id})
            if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                i = data["data"]["issueUpdate"]["issue"]
                asg = (i.get("assignee") or {}).get("name") or "unassigned"
                print(f"{i['identifier']} -> assignee: {asg}")
                did_something = True
            else:
                print("Assign update failed.")

    # Delegate: --delegate <agent-name> | none. Agents can't be plain assignees
    # (Linear silently ignores an app user in assigneeId); delegation is the
    # supported path — the human stays assignee, the agent becomes delegate.
    if getattr(args, "delegate", None) is not None:
        if args.delegate.lower() == "none":
            delegate_id = None
        else:
            delegate_id = resolve_agent_id(api_key, cfg, args.delegate)
            if not delegate_id:
                names = ", ".join(a["name"] for a in get_agents(api_key, cfg)) or "none installed"
                print(f"Warning: agent '{args.delegate}' not found. Available agents: {names}", file=sys.stderr)
                delegate_id = ...

        if delegate_id is not ...:
            data = gql(api_key, """
                mutation($id: String!, $delegateId: String) {
                    issueUpdate(id: $id, input: { delegateId: $delegateId }) {
                        success
                        issue { identifier delegate { name } }
                    }
                }
            """, {"id": issue["id"], "delegateId": delegate_id})
            if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                i = data["data"]["issueUpdate"]["issue"]
                dg = (i.get("delegate") or {}).get("name") or "no agent"
                print(f"{i['identifier']} -> delegate: {dg}")
                did_something = True
            else:
                print("Delegate update failed.")

    # Due date: --due-date YYYY-MM-DD | none
    if args.due_date is not None:
        due = parse_due_date(args.due_date)
        data = gql(api_key, """
            mutation($id: String!, $due: TimelessDate) {
                issueUpdate(id: $id, input: { dueDate: $due }) {
                    success
                    issue { identifier dueDate }
                }
            }
        """, {"id": issue["id"], "due": due})
        if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
            i = data["data"]["issueUpdate"]["issue"]
            print(f"{i['identifier']} -> due: {i['dueDate'] or 'cleared'}")
            did_something = True
        else:
            print("Due date update failed.")

    # Comment (a proof already folds its comment in above, clearing `comment`)
    if comment:
        data = gql(api_key, """
            mutation($input: CommentCreateInput!) {
                commentCreate(input: $input) { success }
            }
        """, {"input": {"issueId": issue["id"], "body": comment}})

        if check_errors(data):
            return False

        if data["data"]["commentCreate"]["success"]:
            print(f"Comment added to {identifier}.")
        else:
            print("Comment failed.")
        did_something = True

    if not did_something and single:
        print("Nothing to do. Use --done, --pickup, --todo, --status, --cycle, --label, --priority, --assign, --delegate, --title, --description, --due-date, or --comment.")
    return did_something


