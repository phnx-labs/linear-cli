AGENT_LABEL_PREFIX = "agent:"


def classify_agent_labels(node: dict, label_names: list[str], roster: list[str]) -> tuple[str, str]:
    """Decide what to do with ONE issue and ALL the legacy `agent:*` labels on it.

    Deciding per issue rather than per label is the whole point: an issue can
    carry two of these labels, and `issueUpdate(labelIds:)` replaces the entire
    label set, so two writes computed from the same pre-mutation snapshot would
    resurrect each other's stripped label and the second delegate would silently
    overwrite the first.

    Returns (verdict, detail) where verdict is one of:
      migrate    — the labels agree on one real agent and the issue has no delegate
      already    — that agent is already the delegate; just strip the labels
      conflict   — the labels disagree, or they name someone other than the
                   current delegate. Never overwrite; a human decides.
      unresolved — at least one label suffix is not a delegatable agent

    Pure decision logic, no I/O, so every branch is testable without touching a
    workspace.
    """
    if not label_names:
        return "already", ""      # nothing to do; caller filters these out
    suffixes = [n[len(AGENT_LABEL_PREFIX):].strip() for n in label_names]
    resolved, unknown = [], []
    for s in suffixes:
        match = next((r for r in roster if r.lower() == s.lower()), None)
        (resolved if match else unknown).append(match or s)

    if unknown:
        # Mixed state needs a human: leave the issue exactly as it is, including
        # any sibling label that would have resolved.
        return "unresolved", ", ".join(f"'{s}' is not a delegatable agent" for s in unknown)

    targets = sorted(set(resolved), key=str.lower)
    if len(targets) > 1:
        return "conflict", f"labels name {' and '.join(targets)} — cannot pick one"

    target = targets[0]
    current = delegate_of(node)
    if current is None:
        return "migrate", target
    if current.lower() == target.lower():
        return "already", target
    return "conflict", f"delegated to {current}, label says {target}"


CARRIER_PAGE = 200


def label_carrier_ids(api_key: str, label_id: str) -> tuple[set[str], bool] | None:
    """(ids of the issues carrying this label, truncated?) — workspace-wide.
    None on API error.

    Deliberately not team-scoped: `list_team_labels` also returns workspace-wide
    labels (`team: { null: true }`), so a label this team has finished with may
    still be carrying ownership on another team's issues. Deleting on the
    strength of a team-scoped scan would strip those silently.

    `includeArchived: true` matters — the connection excludes archived issues by
    default, so a label carried only by archived issues would look unused and be
    deleted.

    The truncation flag is load-bearing, not bookkeeping. The caller subtracts
    the issues this run clears from this set, so a *partial* page whose every
    entry happens to be cleared subtracts to empty and reads as "nothing carries
    it" — deleting a label that hundreds of untouched issues still use. Asking
    for one more than the page size is how we can tell.
    """
    data = gql(api_key, """
        query($id: ID!, $first: Int!) {
            issues(filter: { labels: { id: { eq: $id } } },
                   includeArchived: true, first: $first) {
                nodes { id }
            }
        }
    """, {"id": label_id, "first": CARRIER_PAGE + 1})
    if check_errors(data):
        return None
    nodes = ((data.get("data") or {}).get("issues") or {}).get("nodes", [])
    return {n["id"] for n in nodes[:CARRIER_PAGE]}, len(nodes) > CARRIER_PAGE


def cmd_migrate_agent_labels(args, cfg, api_key, team_id):
    """Migrate legacy `agent:<name>` ownership labels to native delegates.

    Dry run by default; `--apply` writes. An issue already delegated to a
    different agent is never overwritten — it is reported as a conflict and left
    exactly as it was. A label whose suffix is not a delegatable agent is
    reported as unresolved and left in place.

    `--apply` exits non-zero when anything is left behind, so an unattended run
    cannot mistake a partial migration for a clean one. A dry run exits 0: it is
    an inspection, and reporting work-to-do as a failure is what made every
    future run red.
    """
    roster = [a["name"] for a in get_agents(api_key, cfg)]
    if not roster:
        print("No agent members found in this workspace; nothing can be resolved.",
              file=sys.stderr)
        sys.exit(1)

    # Every issue in the team carrying any `agent:*` label, in any state — a Done
    # issue keeps its label until we strip it, and the label can't be deleted
    # while it is still in use.
    issue_filter = {
        "team": {"id": {"eq": team_id}},
        "labels": {"name": {"startsWith": AGENT_LABEL_PREFIX}},
    }
    query = """query($filter: IssueFilter!, $cursor: String) {
        issues(filter: $filter, first: 100, after: $cursor) {
            pageInfo { hasNextPage endCursor }
            nodes {
                id identifier title
                state { name }
                delegate { name }
                labels { nodes { id name } }
            }
        }
    }"""
    nodes = paginate_connection(api_key, query, ["issues"], {"filter": issue_filter})
    if nodes is None:
        sys.exit(1)

    # One row per issue: (node, [agent labels on it], verdict, detail).
    rows = []
    for n in nodes:
        labels = [l for l in n.get("labels", {}).get("nodes", [])
                  if l["name"].startswith(AGENT_LABEL_PREFIX)]
        if not labels:
            continue
        verdict, detail = classify_agent_labels(n, [l["name"] for l in labels], roster)
        rows.append((n, labels, verdict, detail))

    def of(kind):
        return [r for r in rows if r[2] == kind]

    mode = "APPLY" if args.apply else "DRY RUN"
    print(f"[{mode}] {len(rows)} issue(s) carry a legacy '{AGENT_LABEL_PREFIX}*' label")
    print()

    def names(labels):
        return ",".join(l["name"] for l in labels)

    for n, labels, _, agent in of("migrate"):
        print(f"  migrate    {n['identifier']:<10} {names(labels):<24} -> delegate: {agent}")
    for n, labels, _, agent in of("already"):
        print(f"  strip      {n['identifier']:<10} {names(labels):<24} (already delegated to {agent})")
    for n, labels, _, why in of("conflict"):
        print(f"  CONFLICT   {n['identifier']:<10} {names(labels):<24} {why}", file=sys.stderr)
    for n, labels, _, why in of("unresolved"):
        print(f"  UNRESOLVED {n['identifier']:<10} {names(labels):<24} {why}", file=sys.stderr)
    print()

    # Counters must reflect what actually happened, not what was planned — the
    # summary line is what a person or a script reads to call the job done.
    migrated = stripped = 0
    write_failures = 0
    blocked_labels = {l["name"] for _, labels, v, _ in rows
                      if v in ("conflict", "unresolved") for l in labels}

    # Issues whose agent labels this run removes. In a dry run that is every
    # planned row: the delete gate has to reason about the state the migration
    # WOULD leave behind, or the preview reports every label as still in use —
    # by the very issues it just said it would strip.
    cleared_ids = {n["id"] for n, _, v, _ in rows if v in ("migrate", "already")}

    if args.apply:
        for n, labels, verdict, detail in rows:
            if verdict not in ("migrate", "already"):
                continue
            drop = {l["id"] for l in labels}
            keep = [x["id"] for x in n["labels"]["nodes"] if x["id"] not in drop]
            input_obj = {"labelIds": keep}
            if verdict == "migrate":
                aid = resolve_agent_id(api_key, cfg, detail)
                if not aid:
                    print(f"  FAILED     {n['identifier']} — no agent id for {detail}",
                          file=sys.stderr)
                    write_failures += 1
                    blocked_labels.update(l["name"] for l in labels)
                    continue
                input_obj["delegateId"] = aid
            data = gql(api_key, """
                mutation($id: String!, $input: IssueUpdateInput!) {
                    issueUpdate(id: $id, input: $input) {
                        success
                        issue { identifier delegate { name } }
                    }
                }
            """, {"id": n["id"], "input": input_obj})
            if check_errors(data) or not ((data.get("data") or {}).get("issueUpdate") or {}).get("success"):
                print(f"  FAILED     {n['identifier']} — issueUpdate did not succeed",
                      file=sys.stderr)
                write_failures += 1
                blocked_labels.update(l["name"] for l in labels)
                continue
            issue = data["data"]["issueUpdate"]["issue"]
            dg = (issue.get("delegate") or {}).get("name") or "none"
            print(f"  done       {issue['identifier']:<10} delegate={dg}")
            if verdict == "migrate":
                migrated += 1
            else:
                stripped += 1

    # Retire every `agent:*` label that nothing carries any more. A label still
    # on a conflicting, unresolved, or failed issue is deliberately kept, and so
    # is one still carried outside the scanned team.
    delete_failures = 0
    labels = [l for l in list_team_labels(api_key, team_id)
              if l["name"].startswith(AGENT_LABEL_PREFIX)]
    for l in sorted(labels, key=lambda x: x["name"]):
        if l["name"] in blocked_labels:
            print(f"  keep       label {l['name']} — still in use by an unmigrated issue")
            continue
        found = label_carrier_ids(api_key, l["id"])
        if found is None:
            print(f"  FAILED     label {l['name']} — could not look up what carries it",
                  file=sys.stderr)
            delete_failures += 1
            continue
        carriers, truncated = found
        if truncated:
            print(f"  keep       label {l['name']} — more than {CARRIER_PAGE} issues "
                  f"carry it; too many to confirm it is free")
            continue
        # Whatever this run clears no longer counts against the label. In a dry
        # run that projection is the whole point of the preview. The remainder
        # may be on another team, or archived, or simply not scanned — the one
        # thing worth saying is that this run did not clear it.
        if carriers - cleared_ids:
            print(f"  keep       label {l['name']} — still carried by an issue "
                  f"this run did not migrate")
            continue
        if not args.apply:
            print(f"  delete     label {l['name']} (nothing carries it after migration)")
            continue
        data = gql(api_key, """
            mutation($id: String!) { issueLabelDelete(id: $id) { success } }
        """, {"id": l["id"]})
        if check_errors(data) or not (data.get("data") or {}).get("issueLabelDelete", {}).get("success"):
            print(f"  FAILED     label {l['name']} — delete did not succeed", file=sys.stderr)
            delete_failures += 1
            continue
        print(f"  deleted    label {l['name']}")

    print()
    print(f"migrated={migrated} stripped={stripped} "
          f"conflicts={len(of('conflict'))} unresolved={len(of('unresolved'))} "
          f"failures={write_failures + delete_failures}")

    left_behind = of("conflict") or of("unresolved") or write_failures or delete_failures
    if not args.apply:
        # These are independent: a lookup failure must not swallow the guidance
        # for conflicts a human still has to resolve.
        if of("conflict") or of("unresolved"):
            print("Dry run only. The entries above need a human before --apply can "
                  "finish: resolve each conflict, and rename or remove any label "
                  "whose suffix is not an agent.")
        if delete_failures:
            print("Could not reach the API to check what still carries some labels "
                  "— re-run once it responds.")
        if not left_behind:
            print("Dry run only. Re-run with --apply to write.")
        return
    if left_behind:
        print("Migration incomplete — resolve the entries above by hand, then re-run.",
              file=sys.stderr)
        sys.exit(1)


def cmd_users(args, cfg, api_key, team_id):
    """List workspace members, grouped into humans (assign with --assign) and
    agents (delegate with --delegate) — the two are distinct in Linear."""
    users = list_workspace_users(api_key)
    if args.json:
        users.sort(key=lambda u: u["name"].lower())
        print(json.dumps(users, indent=2))
        return
    humans = sorted((u for u in users if not u.get("app")), key=lambda u: u["name"].lower())
    agents = sorted((u for u in users if u.get("app")), key=lambda u: u["name"].lower())
    print(f"Humans ({len(humans)})  — assign with --assign <email or name>:")
    for u in humans:
        print(f"  {u['name']:25s}  {u.get('email') or '-'}")
    print(f"\nAgents ({len(agents)})  — delegate with --delegate <name>:")
    for u in agents:
        print(f"  {u['name']:25s}  (app user)")


def cmd_states(args, cfg, api_key, team_id):
    """List the team's workflow states — the valid values for --status / --done.

    Without this, agents guess state names and only learn they were wrong when a
    mutation fails. Bypasses the cfg cache so the list is always current.
    """
    fresh = {**cfg, "states": None}
    states = get_states(api_key, team_id, fresh)
    if not states:
        return
    # Order by workflow type, then name, so the progression reads top-to-bottom.
    type_order = {"backlog": 0, "unstarted": 1, "started": 2, "completed": 3, "canceled": 4}
    items = sorted(states.items(), key=lambda kv: (type_order.get(kv[1]["type"], 9), kv[0]))
    if args.json:
        print(json.dumps(
            [{"name": name, "type": meta["type"], "id": meta["id"]} for name, meta in items],
            indent=2,
        ))
        return
    print(f"{len(items)} workflow state(s):")
    for name, meta in items:
        print(f"  {name:20s}  {meta['type']}")


_INBOX_TYPE_LABEL = {
    "issueNewComment": "comment",
    "issueCommentMention": "mention",
    "issueMention": "mention",
    "issueCommentReaction": "reaction",
    "issueAssignedToYou": "assigned",
    "issueUnassignedFromYou": "unassigned",
    "issueStatusChanged": "status",
    "issueDue": "due",
    "issueBlocking": "blocking",
    "issueEmojiReaction": "reaction",
    "issueSubscribed": "subscribed",
}


def _mark_notifications_read(api_key, ids):
    """Mark specific notifications read via notificationUpdate. Returns (ok, failed)."""
    import datetime
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    ok, failed = [], []
    for nid in ids:
        data = gql(api_key, """
            mutation($id: String!, $at: DateTime!) {
              notificationUpdate(id: $id, input: { readAt: $at }) { success }
            }
        """, {"id": nid, "at": now})
        # check_errors prints "Error: <message>" to stderr on a GraphQL error,
        # matching the other per-item mutation loops in this file.
        had_error = check_errors(data)
        success = (((data.get("data") or {}).get("notificationUpdate") or {}).get("success"))
        (ok if success and not had_error else failed).append(nid)
    return ok, failed


def cmd_inbox(args, cfg, api_key, team_id):
    """Show your Linear inbox — notifications (comments, mentions, assignments,
    status changes). Acts too: --read <id> marks notification(s) read, --read-all
    marks everything read. Unread only by default; --all lists read as well.

    Agents: `--json` returns full metadata per notification — the issue
    (identifier + url + state), the comment (id + url + body), the thread parent,
    and the actor — enough to follow up. Reply on a ticket with
    `linear update <identifier> --comment "..."`; dismiss with
    `linear inbox --read <notification-id>`."""
    # --- actions take precedence over listing ---
    if getattr(args, "read_all", False):
        data = gql(api_key, "mutation { notificationMarkReadAll { success } }")
        ok = not check_errors(data) and (((data.get("data") or {}).get("notificationMarkReadAll") or {}).get("success"))
        if ok:
            print("Marked all notifications read.")
        else:
            print("Failed to mark all read.", file=sys.stderr)
            sys.exit(1)
        return
    read_ids = getattr(args, "read", None) or []
    if read_ids:
        ok, failed = _mark_notifications_read(api_key, read_ids)
        if ok:
            print(f"Marked read ({len(ok)}): {', '.join(ok)}")
        if failed:
            print(f"Failed to mark read: {', '.join(failed)}", file=sys.stderr)
            sys.exit(1)
        return

    # --- list ---
    limit = getattr(args, "limit", 30)  # argparse always supplies a default; honor an explicit value
    if limit < 1:
        print("inbox: --limit must be >= 1", file=sys.stderr)
        return
    data = gql(api_key, """
        query($n: Int!) {
          notifications(first: $n) {
            nodes {
              id __typename createdAt readAt
              ... on IssueNotification {
                type url inboxUrl
                issue { identifier title url state { name type } }
                comment { id url body }
                parentComment { id url }
                actor { name displayName }
              }
            }
          }
        }
    """, {"n": limit})
    if check_errors(data):
        return
    nodes = ((data.get("data") or {}).get("notifications") or {}).get("nodes") or []
    # Only issue notifications carry an issue; ignore project/other kinds for now.
    items = [n for n in nodes if n.get("issue")]
    if not getattr(args, "all", False):
        items = [n for n in items if not n.get("readAt")]

    if getattr(args, "json", False):
        print(json.dumps(items, indent=2))
        return

    if not items:
        hint = "" if getattr(args, "all", False) else " (no unread — use --all to include read)"
        print(f"Inbox empty{hint}.")
        return

    unread = sum(1 for n in items if not n.get("readAt"))
    scope = "" if getattr(args, "all", False) else " unread"
    print(f"Inbox — {len(items)}{scope} ({unread} unread):")
    for n in items:
        iss = n.get("issue") or {}
        actor = n.get("actor") or {}
        who = actor.get("name") or actor.get("displayName") or "-"
        label = _INBOX_TYPE_LABEL.get(n.get("type"), n.get("type") or "note")
        dot = " " if n.get("readAt") else "*"
        title = (iss.get("title") or "")[:48]
        print(f"  {dot} {iss.get('identifier','-'):11.11s}{label:11.11s}{who:14.14s}{title}")
        body = ((n.get("comment") or {}).get("body") or "").replace("\n", " ").strip()
        if body and label in ("comment", "mention"):
            print(f'      "{body[:96]}"')
    print('\nReply:  linear update <ID> --comment "..."    ·    '
          'Dismiss:  linear inbox --read <notification-id>  (id in --json)')


def cmd_agents(args, cfg, api_key, team_id):
    """List the workspace's agent members — the app users you can `--delegate` to.

    Auto-detected from Linear (the `app` user flag), cached, and refreshed every
    6h. `--refresh` forces an immediate re-fetch — run it after installing or
    removing an agent app so the roster (and `--delegate <name>`) stays current.
    """
    agents = get_agents(api_key, cfg, force=args.refresh)
    if args.json:
        print(json.dumps(agents, indent=2))
        return
    if not agents:
        print("No agent members found. Install agent apps in Linear "
              "(Settings -> API -> Applications), then: linear agents --refresh")
        return
    print(f"{len(agents)} agent(s)  (auto-refreshes every 6h; --refresh to force):")
    for a in agents:
        print(f"  {a['name']:20s}  delegate: linear update <ID> --delegate {a['name'].lower()}")


def print_queue_list(detailed: bool = False) -> None:
    """Print queued close intents (shared by bare `queue` and `queue list`)."""
    intents = list_queue_intents()
    if not intents:
        print("Queue empty.")
        return
    print(f"{len(intents)} close intent(s) queued:")
    for intent in intents:
        ident = intent.get("identifier", "?")
        state = intent.get("state", "Done")
        attempts = intent.get("attempts", 0) or 0
        if detailed:
            nxt = intent.get("next_attempt")
            status = f"attempts={attempts}"
            if nxt:
                status += f", next {nxt}"
            print(f"  {ident} -> {state} ({status})")
        else:
            print(f"  {ident} -> {state} (attempts={attempts})")
    print("Run `linear queue drain` to apply them.")


def cmd_queue(args, cfg, api_key, team_id):
    """Manage the durable local queue for closes that could not be written
    immediately (typically because Linear returned a rate limit)."""
    action = getattr(args, "queue_action", None)
    if action == "drain":
        if getattr(args, "dry_run", False):
            intents = list_queue_intents()
            if not intents:
                print("Queue empty.")
                return
            for intent in intents:
                ident = intent.get("identifier", "?")
                state = intent.get("state", "Done")
                attempts = intent.get("attempts", 0) or 0
                nxt = intent.get("next_attempt")
                status = f"retry {attempts}"
                if nxt:
                    status += f", next {nxt}"
                print(f"{ident} -> {state} ({status})")
            return
        once = bool(getattr(args, "once", False))
        applied, remaining = drain_queue(
            api_key, team_id, cfg, quiet=False, once=once,
        )
        if remaining == 0:
            print(f"Drained {applied} intent(s). Queue empty.")
        else:
            print(f"Applied {applied}, {remaining} pending retry.")
        return

    # Bare `linear queue` and `linear queue list` both list intents.
    if action in (None, "list"):
        print_queue_list(detailed=(action == "list"))
        return

    print(f"Unknown queue action: {action}", file=sys.stderr)
    sys.exit(2)


