def cmd_cycles(args, cfg, api_key, team_id):
    """List all cycles for the team, with dates, status, issue counts."""
    cycles = list_team_cycles(api_key, team_id)
    if not cycles:
        print("No cycles found.")
        return

    if args.json:
        print(json.dumps(cycles, indent=2))
        return

    # Sort by startsAt descending (most recent first)
    cycles.sort(key=lambda c: c.get("startsAt") or "", reverse=True)

    # Find the currently-active cycle id so we can mark it in output.
    active_id = get_cycle_id(api_key, team_id, "active")
    next_id = get_cycle_id(api_key, team_id, "next")

    # Format: status marker | name (number) | startsAt -> endsAt | issue count
    for c in cycles:
        cid = c.get("id")
        name = c.get("name") or f"Cycle {c.get('number')}"
        starts = (c.get("startsAt") or "")[:10]
        ends = (c.get("endsAt") or "")[:10]
        history = c.get("issueCountHistory") or []
        count = history[-1] if history else 0

        marker = "  "
        if cid == active_id:
            marker = "* "
        elif cid == next_id:
            marker = "> "
        elif c.get("completedAt"):
            marker = "- "

        print(f"{marker}{name:40s}  {starts} → {ends}  {count} issue(s)")

    print("\n(* = active, > = next, - = completed)")


