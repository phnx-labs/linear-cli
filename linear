def cmd_update(args, cfg, api_key, team_id):
    # Require proof when marking done
    if args.done and not args.proof:
        print("Cannot mark done without proof. Provide at least one --proof:", file=sys.stderr)
        print("  --proof /path/to/screenshot.png   (file upload)", file=sys.stderr)
        print("  --proof https://example.com/result (URL)", file=sys.stderr)
        print('  --proof "Sent 15/30 emails"        (text)', file=sys.stderr)
        sys.exit(1)

    issue = resolve_issue(api_key, team_id, args.identifier)
    if not issue:
        print(f"Issue {args.identifier} not found.")
        sys.exit(1)

    did_something = False

    # Post proof as a comment before status change
    if args.proof:
        proof_body = build_proof_comment(api_key, args.proof)
        if args.comment:
            proof_body = f"{args.comment}\n\n{proof_body}"

        data = gql(api_key, """
            mutation($input: CommentCreateInput!) {
                commentCreate(input: $input) { success }
            }
        """, {"input": {"issueId": issue["id"], "body": proof_body}})

        if check_errors(data):
            return
        if data["data"]["commentCreate"]["success"]:
            print(f"Proof posted to {args.identifier}.")
        else:
            print("Proof comment failed.", file=sys.stderr)
            sys.exit(1)
        did_something = True
        # Comment already included in proof, don't post separately
        args.comment = None

    # Status change
    target_state = None
    if args.done:
        target_state = "Done"
    elif args.pickup:
        target_state = "In Progress"
    elif args.todo:
        target_state = "Todo"
    elif args.status:
        target_state = args.status

    if target_state:
        states = get_states(api_key, team_id, cfg)
        state_id = resolve_state_id(states, target_state)
        if not state_id:
            print(f"State '{target_state}' not found. Available: {', '.join(states.keys())}", file=sys.stderr)
            sys.exit(1)

        data = gql(api_key, """
            mutation($id: String!, $stateId: String!) {
                issueUpdate(id: $id, input: { stateId: $stateId }) {
                    success
                    issue { identifier title state { name } }
                }
            }
        """, {"id": issue["id"], "stateId": state_id})

        if check_errors(data):
            return

        result = data["data"]["issueUpdate"]
        if result["success"]:
            i = result["issue"]
            print(f"{i['identifier']} -> {i['state']['name']}")
        else:
            print("Status update failed.")
        did_something = True

    # Labels (add via --label, remove via --unlabel)
    if args.label or args.unlabel:
        label_data = gql(api_key, """
            query($teamId: ID!) {
                issueLabels(
                    filter: {
                        or: [
                            { team: { id: { eq: $teamId } } }
                            { team: { null: true } }
                        ]
                    }
                    first: 200
                ) {
                    nodes { id name }
                }
            }
        """, {"teamId": team_id})

        if not check_errors(label_data):
            all_labels = label_data["data"]["issueLabels"]["nodes"]
            label_map = {l["name"]: l["id"] for l in all_labels}

            # Also get current labels on the issue
            issue_data = gql(api_key, f"""{{
                issue(id: "{issue['id']}") {{
                    labels {{ nodes {{ id name }} }}
                }}
            }}""")
            current_ids = []
            current_names_by_id = {}
            if not check_errors(issue_data):
                for l in issue_data["data"]["issue"]["labels"]["nodes"]:
                    current_ids.append(l["id"])
                    current_names_by_id[l["id"]] = l["name"]

            label_ids = list(current_ids)
            added = []
            for lbl in args.label or []:
                if lbl in label_map:
                    if label_map[lbl] not in label_ids:
                        label_ids.append(label_map[lbl])
                        added.append(lbl)
                else:
                    print(f"Warning: label '{lbl}' not found, skipping.", file=sys.stderr)

            removed = []
            for lbl in args.unlabel or []:
                if lbl in label_map and label_map[lbl] in label_ids:
                    label_ids.remove(label_map[lbl])
                    removed.append(lbl)
                else:
                    print(f"Warning: label '{lbl}' not on this issue, skipping.", file=sys.stderr)

            if added or removed:
                data = gql(api_key, """
                    mutation($id: String!, $labelIds: [String!]!) {
                        issueUpdate(id: $id, input: { labelIds: $labelIds }) {
                            success
                        }
                    }
                """, {"id": issue["id"], "labelIds": label_ids})

                if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                    parts = []
                    if added:
                        parts.append(f"added {', '.join(added)}")
                    if removed:
                        parts.append(f"removed {', '.join(removed)}")
                    print(f"Labels on {args.identifier}: {'; '.join(parts)}")
                else:
                    print("Label update failed.")
                did_something = True

    # Cycle move: --cycle active | next | none
    if args.cycle:
        choice = args.cycle.lower()
        new_cycle_id: str | None = None
        if choice == "none":
            new_cycle_id = None
        elif choice in ("active", "next"):
            new_cycle_id = get_cycle_id(api_key, team_id, choice)
            if not new_cycle_id:
                print(f"Warning: no {choice} cycle found; skipping cycle move.", file=sys.stderr)
                new_cycle_id = ...  # sentinel — skip mutation below

        if new_cycle_id is not ...:
            data = gql(api_key, """
                mutation($id: String!, $cycleId: String) {
                    issueUpdate(id: $id, input: { cycleId: $cycleId }) {
                        success
                        issue { identifier cycle { name } }
                    }
                }
            """, {"id": issue["id"], "cycleId": new_cycle_id})
            if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                i = data["data"]["issueUpdate"]["issue"]
                cyc = (i.get("cycle") or {}).get("name") or "no cycle"
                print(f"{i['identifier']} -> cycle: {cyc}")
                did_something = True
            else:
                print("Cycle update failed.")

    # Title / description / estimate: batched in one mutation
    title_desc_input: dict = {}
    if args.title is not None:
        title_desc_input["title"] = args.title
    description = read_description(args.description, args.description_file)
    if description is not None:
        title_desc_input["description"] = description
    if args.estimate is not None:
        title_desc_input["estimate"] = args.estimate
    if args.parent is not None:
        if args.parent.lower() == "none":
            title_desc_input["parentId"] = None
        else:
            parent_issue = resolve_issue(api_key, team_id, args.parent)
            if parent_issue:
                title_desc_input["parentId"] = parent_issue["id"]
            else:
                print(f"Warning: parent '{args.parent}' not found; skipping.", file=sys.stderr)
    update_project_id = None
    if args.project is not None:
        if args.project.lower() == "none":
            title_desc_input["projectId"] = None
        else:
            update_project_id = resolve_project_id(api_key, team_id, args.project)
            if update_project_id:
                title_desc_input["projectId"] = update_project_id
    if args.milestone is not None:
        if args.milestone.lower() == "none":
            title_desc_input["projectMilestoneId"] = None
        else:
            mid = resolve_milestone_id(api_key, team_id, args.milestone, update_project_id)
            if mid:
                title_desc_input["projectMilestoneId"] = mid
    if title_desc_input:
        data = gql(api_key, """
            mutation($id: String!, $input: IssueUpdateInput!) {
                issueUpdate(id: $id, input: $input) {
                    success
                    issue { identifier title }
                }
            }
        """, {"id": issue["id"], "input": title_desc_input})
        if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
            i = data["data"]["issueUpdate"]["issue"]
            changed = ", ".join(title_desc_input.keys())
            print(f"{i['identifier']} -> updated: {changed}")
            did_something = True
        else:
            print("Title/description update failed.")

    # Priority: --priority urgent|high|medium|low|none
    if args.priority is not None:
        pri = parse_priority(args.priority)
        data = gql(api_key, """
            mutation($id: String!, $priority: Int!) {
                issueUpdate(id: $id, input: { priority: $priority }) {
                    success
                    issue { identifier priority }
                }
            }
        """, {"id": issue["id"], "priority": pri})
        if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
            i = data["data"]["issueUpdate"]["issue"]
            name = PRIORITY_MAP.get(i.get("priority", 0), "-")
            print(f"{i['identifier']} -> priority: {name}")
            did_something = True
        else:
            print("Priority update failed.")

    # Assign: --assign email | none
    if args.assign is not None:
        if args.assign.lower() == "none":
            assignee_id = None
        elif "@" in args.assign:
            assignee_id = resolve_user_id_by_email(api_key, args.assign.strip())
            if not assignee_id:
                print(f"Warning: user '{args.assign}' not found; skipping reassign.", file=sys.stderr)
                assignee_id = ...
        else:
            print(f"Warning: --assign expects an email or 'none'; got '{args.assign}'. Skipping.", file=sys.stderr)
            assignee_id = ...

        if assignee_id is not ...:
            data = gql(api_key, """
                mutation($id: String!, $assigneeId: String) {
                    issueUpdate(id: $id, input: { assigneeId: $assigneeId }) {
                        success
                        issue { identifier assignee { name } }
                    }
                }
            """, {"id": issue["id"], "assigneeId": assignee_id})
            if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
                i = data["data"]["issueUpdate"]["issue"]
                asg = (i.get("assignee") or {}).get("name") or "unassigned"
                print(f"{i['identifier']} -> assignee: {asg}")
                did_something = True
            else:
                print("Assign update failed.")

    # Due date: --due-date YYYY-MM-DD | none
    if args.due_date is not None:
        due = parse_due_date(args.due_date)
        data = gql(api_key, """
            mutation($id: String!, $due: TimelessDate) {
                issueUpdate(id: $id, input: { dueDate: $due }) {
                    success
                    issue { identifier dueDate }
                }
            }
        """, {"id": issue["id"], "due": due})
        if not check_errors(data) and data["data"]["issueUpdate"]["success"]:
            i = data["data"]["issueUpdate"]["issue"]
            print(f"{i['identifier']} -> due: {i['dueDate'] or 'cleared'}")
            did_something = True
        else:
            print("Due date update failed.")

    # Comment
    if args.comment:
        comment_body = args.comment

        data = gql(api_key, """
            mutation($input: CommentCreateInput!) {
                commentCreate(input: $input) { success }
            }
        """, {"input": {"issueId": issue["id"], "body": comment_body}})

        if check_errors(data):
            return

        if data["data"]["commentCreate"]["success"]:
            print(f"Comment added to {args.identifier}.")
        else:
            print("Comment failed.")
        did_something = True

    if not did_something:
        print("Nothing to do. Use --done, --pickup, --todo, --status, --cycle, --label, --priority, --assign, --title, --description, --due-date, or --comment.")
        sys.exit(1)


